{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install dependencies",
            "type": "shell",
            "command": "uv sync",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "Create data and log directories",
            "type": "shell",
            "command": "mkdir -p data logs",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "Start services (config-driven)",
            "type": "shell",
            "command": "bash deploy/start.sh; until curl -sf http://localhost:6333/healthz > /dev/null 2>&1 && curl -sf http://localhost:11434 > /dev/null 2>&1; do sleep 1; done",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "Pull Ollama models",
            "type": "shell",
            "command": "docker exec ollama ollama pull qwen3:30b-a3b && docker exec ollama ollama pull bge-m3",
            "dependsOn": ["Start services (config-driven)"],
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Setup: All prerequisites",
            "dependsOn": [
                "Install dependencies",
                "Create data and log directories",
                "Pull Ollama models"
            ],
            "dependsOrder": "parallel",
            "group": "build"
        },
        {
            // Build the API + UI image with uv (see deploy/Dockerfile).
            "label": "Build API image (uv)",
            "type": "shell",
            "command": "docker build -t dffrnt-assistant:latest -f deploy/Dockerfile .",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            // Production: (re)build the image from source, then hand off to
            // run.sh — the canonical runner — which brings up the full GPU-aware
            // containerized stack (Qdrant + Ollama + API), ensures models, and
            // waits for health. Mirrors the deployed artifact.
            "label": "Run production stack (Docker)",
            "type": "shell",
            "command": "docker build -t dffrnt-assistant:latest -f deploy/Dockerfile . && bash deploy/run.sh start",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" },
            "group": "build"
        },
        {
            // Stop everything (both dev and prod containers).
            "label": "Stop stack (Docker)",
            "type": "shell",
            "command": "bash deploy/run.sh stop",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ]
}
