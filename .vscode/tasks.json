{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install dependencies",
            "type": "shell",
            "command": "uv sync",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "Create data and log directories",
            "type": "shell",
            "command": "mkdir -p data logs",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            // Dev loop: qdrant + ollama containers only (GPU-aware, from
            // config.toml), waits for health and ensures the configured
            // models are pulled — the API then runs on the host under the
            // debugger. CLI twin of the manager's browser panel; see installer/cli.py.
            "label": "Start services (config-driven)",
            "type": "shell",
            "command": "uv run python -m installer dev",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Setup: All prerequisites",
            "dependsOn": [
                "Install dependencies",
                "Create data and log directories",
                "Start services (config-driven)"
            ],
            "dependsOrder": "parallel",
            "group": "build"
        },
        {
            // Build the API + UI image with uv (see deploy/Dockerfile).
            "label": "Build API image (uv)",
            "type": "shell",
            "command": "docker build -t dffrnt-assistant:latest -f deploy/Dockerfile .",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            // Production: (re)build the image from source, then bring up the
            // full GPU-aware containerized stack (Qdrant + Ollama + API) via
            // the manager CLI — ensures models, prunes, waits for health.
            // Mirrors the deployed artifact.
            "label": "Run production stack (Docker)",
            "type": "shell",
            "command": "docker build -t dffrnt-assistant:latest -f deploy/Dockerfile . && uv run python -m installer start",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" },
            "group": "build"
        },
        {
            // Stop everything (both dev and prod containers).
            "label": "Stop stack (Docker)",
            "type": "shell",
            "command": "uv run python -m installer stop",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "Package: build bundle (AWS)",
            "type": "shell",
            "command": "bash deploy/package.sh TARGET_SYSTEM=AWS",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" },
            "group": "build"
        },
        {
            // package.sh freezes installer/ into the dffrnt-manager binary and
            // ships it both inside the bundle and next to the tarball — no
            // separate "ship the installer" step exists anymore.
            "label": "Package: build bundle (OFFLINE)",
            "type": "shell",
            "command": "bash deploy/package.sh TARGET_SYSTEM=OFFLINE",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" },
            "group": "build"
        },
        {
            // macOS only: the Linux-frozen dffrnt-manager binary can't run on
            // a Mac, so ship the installer package as SOURCE next to the bundle.
            // The target runs it with the RELOCATABLE PYTHON the portable-runtime
            // task vendors (portable/macos/python/bin/python3 -m installer) — no
            // host Python, no Tk (the panel UI is the browser). MUST follow
            // package.sh (which wipes dist/).
            "label": "Package: ship installer source (macOS)",
            "type": "shell",
            "command": "rm -rf dist/installer && cp -r installer dist/ && find dist/installer -type d -name __pycache__ -exec rm -rf {} + && echo '>> installer source shipped: dist/installer (macOS: portable/macos/python/bin/python3 -m installer)'",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            // Portable macOS runtime -> dist/portable/macos: native Ollama
            // (Metal automatic on Apple Silicon) + colima/lima/docker-CLI for
            // the Qdrant + API containers. Networked build machine only; runs
            // AFTER package.sh (which wipes dist/). Version pins live in the
            // script. Pass x86_64 for Intel Macs (CPU-only inference).
            "label": "Package: fetch macOS portable runtime (Ollama + Docker)",
            "type": "shell",
            "command": "bash deploy/package-macos-portable.sh arm64",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "bash", "args": ["-c"] }
            },
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            // Full macOS package: OFFLINE bundle (models cached; build the app
            // image on/for linux/arm64 so it runs in colima's VM on Apple
            // Silicon), installer source, then the portable runtime.
            "label": "Package: macOS deployment (bundle + installer source + portable runtime)",
            "dependsOn": [
                "Package: build bundle (OFFLINE)",
                "Package: ship installer source (macOS)",
                "Package: fetch macOS portable runtime (Ollama + Docker)"
            ],
            "dependsOrder": "sequence",
            "group": "build"
        }
    ]
}
